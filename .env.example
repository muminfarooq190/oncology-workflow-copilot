APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://oncology:oncology@postgres:5432/oncology
REDIS_URL=redis://redis:6379/0
FHIR_INTEGRATION_URL=http://fhir-integration:8080
TENANT_ID=portfolio
WORKFLOW_STREAM=oncology:workflows
WORKFLOW_CONSUMER_GROUP=orchestrator-workers
WORKFLOW_CONSUMER_NAME=worker-1
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_RETRY_DELAY_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=0.5
WORKER_POLL_MILLISECONDS=5000
WORKER_CLAIM_IDLE_MILLISECONDS=30000
OIDC_ISSUER=http://keycloak:8080/realms/oncology-copilot
OIDC_AUDIENCE=oncology-copilot-api
OPENAI_API_KEY=
OPENAI_MODEL=
EVIDENCE_CORPUS_VERSION=nsclc-v1
